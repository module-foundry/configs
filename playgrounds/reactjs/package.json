    "eslint-plugin-jsdoc": "^63.3.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "react": "^19.2.8",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
